@model ShopTARge23.Models.Kindergartens.KindergartensCreateUpdateViewModel

<style>
    body {
        background-image: url('/images/taust.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .overlay {
        background-color: rgba(255, 255, 255, 0.8); /* Muudetud, et taust oleks õrnalt läbi paistev */
        padding: 50px;
        border-radius: 10px;
        margin: 20px; /* Lisab ruumi ümber overlay */
    }

    h1 {
        text-align: center; /* Joondus keskele */
        color: black; /* Teksti värv must */
    }

    .form-group {
        margin-bottom: 1rem; /* Lisab ruumi vormi elementide vahel */
    }

    .btn-custom {
        background-color: #28a745; /* Roheline nupp */
        color: white; /* Nupu tekst valge */
    }

    .btn-danger-custom {
        background-color: #dc3545; /* Tumepunane nupp */
        color: white; /* Nupu tekst valge */
    }

    .btn-primary-custom {
        background-color: #28a745; /* roheliune nupp */
        color: white; /* Nupu tekst valge */
    }
</style>

<div class="container my-5">
    <div class="overlay shadow">
        @if (Model.Id.HasValue)

        {
            <h1>Update</h1>
        }

        else

        {
            <h1>Create</h1>
        }

        <form method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="UpdatedAt" type="hidden" />

            <div class="form-group row">
                <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="GroupName" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="ChildrenCount" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="KindergartenName" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Teacher" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Teacher" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Files" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-5">
                    <div class="custom-file">
                        <input class="form-control custom-file-input" asp-for="Files" multiple type="file" />
                    </div>
                </div>
            </div>

            <div>
                @foreach (var images in Model.Image)

                {
                    <partial name="_Images" model="images" />
                    <input asp-action="removeImage" asp-controller="kindergartens" asp-route-imageId="@images.ImageId" type="submit" class="btn btn-danger-custom" value="Remove Image" />
                }
            </div>

            <hr />

            @if (Model.Id.HasValue)
            {
                <input asp-action="update" asp-controller="kindergartens" type="submit" class="btn btn-primary-custom" value="Update" />
            }
            else
            {
                <input asp-action="create" asp-controller="kindergartens" type="submit" class="btn btn-primary-custom" value="Create" />
            }

            <a asp-action="Index" asp-controller="kindergartens" class="btn btn-custom">Back</a>
        </form>
    </div>
</div>
