@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    body {
        background-image: url('/images/taust.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .overlay {
        background-color: rgba(255, 255, 255, 0.7); /* Muudetud läbipaistvuse väärtus */
        padding: 50px;
        border-radius: 10px;
    }

        .overlay h1 {
            color: black; /* Määrab h1 teksti värviks musta */
        }

        .overlay p {
            color: black; /* Määrab p teksti värviks musta */
            font-size: 1.2rem; /* Suurendab teksti suurust */
            line-height: 1.5; /* Parandab loetavust */
        }
</style>

<div class="container my-5">
    <div class="text-center overlay shadow">
        <!-- bg-light eemaldatud, et kasutada overlay'i tausta -->
        <h1 class="display-4 mb-4">@ViewData["Title"]</h1>

        <div class="highlight">
            <p>Your privacy is important to us. This policy explains what personal data we collect and how we use, disclose, and protect that data.</p>
        </div>

        <div class="highlight">
            <p>We collect various types of information in connection with the services we provide, including information you provide to us directly when you create an account or contact us, as well as information about your use of our services, such as your interactions with our website.</p>
        </div>

        <div class="highlight">
            <p>We may share your information with third parties in order to provide our services, comply with legal obligations, and improve our offerings. If you have any questions about our privacy policy, please contact us.</p>
        </div>
    </div>
</div>
